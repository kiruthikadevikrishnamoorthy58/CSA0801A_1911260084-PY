import sys
count = 0
memo_count = 0
# Normal recursion
def ways(n):
    global count
    count += 1
    if n <= 1:
        return 1
    return ways(n-1) + ways(n-2)
# Memoisation
def ways_memo(n, memo={}):
    global memo_count
    memo_count += 1
    if n <= 1:
        return 1
    if n not in memo:
        memo[n] = ways_memo(n-1, memo) + ways_memo(n-2, memo)
    return memo[n]
# Check answers from 1 to 6
print("Staircase Results:")
for i in range(1, 7):
    print(i, ":", ways_memo(i))
# Compare function calls
for n in [10, 20, 25, 30]:
    count = 0
    memo_count = 0
    ways(n)
    naive = count
    ways_memo(n, {})
    memo = memo_count
    print("\nn =", n)
    print("Normal Calls:", naive)
    print("Memo Calls:", memo)
# Iterative method
def ways_loop(n):
    a, b = 1, 1
    for i in range(2, n + 1):
        a, b = b, a + b
    return b
print("\nWays for 1000 steps:", ways_loop(1000))